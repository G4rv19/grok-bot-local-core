{
  "computer_screenshot": [
    [
      [
        "description"
      ],
      "Capture a visible app window or main display on a 1280 by 800 canvas. Returns an image and coordinate_token. Input activates the app and may move the real pointer. Mutations invalidate snapshots and coordinates: inspect again before the next action."
    ],
    [
      [
        "inputSchema",
        "properties",
        "target",
        "oneOf"
      ],
      [
        {
          "type": "object",
          "properties": {
            "scope": {
              "type": "string",
              "const": "screen"
            }
          },
          "required": [
            "scope"
          ]
        },
        {
          "type": "object",
          "properties": {
            "scope": {
              "type": "string",
              "const": "app"
            },
            "pid": {
              "type": "integer",
              "minimum": 1
            },
            "target_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "scope",
            "pid",
            "target_id"
          ]
        }
      ]
    ],
    [
      [
        "inputSchema",
        "properties",
        "target",
        "description"
      ],
      "Use the target object returned by computer_apps or computer_resolve_app. Omit only for whole-screen actions."
    ]
  ],
